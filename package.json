{
  "name": "lecvy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --target=es2022 --outfile=worker-build/index.js",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "lint": "oxlint",
    "test": "vitest run",
    "dev:worker": "npm run build && wrangler dev --config wrangler.local.jsonc --port 8787",
    "dev:api": "npm run build:worker && wrangler dev --config wrangler.local.jsonc --port 8787",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
