# Lecvy — Firebase web configuration (Iteration 1: Authentication)
#
# Copy this file to `.env` and fill in the values from the Firebase console:
#   Firebase console → Project settings → General → Your apps → Web app (</>)
#
# The values below are PUBLIC by design — they ship in the browser bundle.
# Never put service-account keys, private keys, or the Firebase Admin SDK
# config in these variables. Server-side secrets belong in a secrets store.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lecvy-ac3cb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lecvy-ac3cb
VITE_FIREBASE_STORAGE_BUCKET=lecvy-ac3cb.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
